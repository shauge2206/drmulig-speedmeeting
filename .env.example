# DrMulig SpeedMeeting - miljovariabler
# Kopier til .env.local for lokal utvikling. Sett de samme i Vercel (Project Settings > Environment Variables).
# Ingen av disse skal committes. Se OPPSETT.md for hvor hver verdi hentes.

# Stripe webhook-signeringshemmelighet (whsec_...). Marker som sensitiv i Vercel.
# Kun til aa bekrefte at webhooken kom fra Stripe. Gir ingen tilgang til Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Payment Link-ID for innevaerende treff (plink_...). Brukes av webhook og av /admin-redirect.
PAYMENT_LINK_ID=plink_xxx

# Slug for innevaerende treff. Redis-noklene er per slug.
TREFF_SLUG=2026-10-06

# Antall plasser per treff.
KAPASITET=30

# Settes automatisk av Upstash-integrasjonen i Vercels markedsplass. Velg EU-region.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
